# ---- Data & artifacts ----
/atlas.html
# Working copies of papers awaiting reading/pinning. Storing a paper is
# republishing it: nothing here may ever be committed except the README.
literature/inbox/*
!literature/inbox/README.md

# The OEIS dump: 32 MB, regenerated daily upstream, and redistributing the
# OEIS is the maintainers' call rather than ours. `workhouse oeis --fetch`
# gets it; the snapshot digest and the scan's verdicts live in
# ledger/sequences.yaml, so a check never needs the file or the network.
literature/oeis/*.gz
# Large inputs/outputs belong outside git (or in LFS). Keep small fixtures in
# tests/fixtures/ and check them in deliberately.
data/raw/
data/interim/
data/processed/
artifacts/
outputs/
*.sqlite
*.sqlite3
*.db
*.parquet
*.h5
*.ckpt
*.pt
*.onnx
corpus-import/archive/
*.npz
__pycache__/
*.pyc

# ---- Lean ----
lean/.lake/
lean/.cache/
*.olean

# ---- LaTeX build artifacts (paper/) ----
*.aux
*.log
*.out
*.toc
paper/*.synctex.gz

# ---- runs/ is pinned evidence and is never ignored ----
# The rules above are extension-global, so a run's own console log matched
# *.log and was silently dropped from the tree while staying in that run's
# SHA256SUMS -- pinned bytes that were not there. tests/test_runs.py caught it.
# Unignoring runs/ is safe precisely because that test requires every file in
# a run directory to be pinned, so nothing can drift in unnoticed.
!runs/**
