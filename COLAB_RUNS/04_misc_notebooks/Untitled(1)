omega = 2*np.pi*f\n","    T = 1.0/f\n","    dt = T/steps_per_cycle\n","    N = int(n_cycles*steps_per_cycle)\n","    t = np.arange(N)*dt\n","\n","    # External base acceleration (in housing frame)\n","    a_ext = A*(omega**2)*np.sin(omega*t)\n","\n","    # Phase in [0, 2π)\n","    phase = (omega*t) % (2*np.pi)\n","\n","    # Smooth step helper\n","    def smoothstep(z):\n","        z = np.clip(z, 0.0, 1.0)\n","        return z*z*(3 - 2*z)\n","\n","    # Piecewise stiffness\n","    k = np.where(phase < switch_phase, k_soft, k_stiff).astype(float)\n","\n","    # Smooth transitions to avoid discontinuities in k(t)\n","    w = smooth_switch_frac * 2*np.pi  # smoothing window (radians)\n","\n","    # Transition at switch_phase: soft -> stiff\n","    d1 = (phase - (switch_phase - w/2)) / w\n","    s1 = smoothstep(d1)\n","    in_win1 = (phase >= (switch_phase - w/2)) & (phase <= (switch_phase + w/2))\n","    k[in_win1] = (1 - s1[in_win1]) * k_soft + s1[in_win1] * k_stiff\n","\n","    # Transition at 0 (wrap-around): stiff -> soft\n","    phase2 = phase.copy()\n","    phase2[phase > (2*np.pi - w/2)] -= 2*np.pi\n","    d2 = (phase2 - (-w/2)) / w\n","    s2 = smoothstep(d2)\n","    in_win2 = (phase <= (w/2)) | (phase >= (2*np.pi - w/2))\n","    k[in_win2] = (1 - s2[in_win2]) * k_stiff + s2[in_win2] * k_soft\n","\n","    # Integrate with a stable semi-implicit Euler scheme (damping-friendly)\n","    x = np.zeros(N)\n","    v = np.zeros(N)\n","    x[0] = 0.0\n","    v[0] = 0.0\n","\n","    for i in range(N-1):\n","        a = (-c*v[i] - k[i]*x[i] - m*a_ext[i]) / m\n","        v[i+1] = v[i] + a*dt\n","        x[i+1] = x[i] + v[i+1]*dt\n","\n","    # Spring force\n","    F = k * x\n","\n","    # Work per timestep: dW = F dx\n","    dx = np.diff(x)\n","    dW = F[:-1] * dx\n","\n","    # Discard transient portion, compute per-cycle work in steady state\n","    discard_cycles = int(0.6*n_cycles)\n","    W_cycles = []\n","    for n in range(discard_cycles, n_cycles-1):\n","        i0 = n*steps_per_cycle\n","        i1 = (n+1)*steps_per_cycle\n","        W_cycles.append(np.sum(dW[i0:i1]))\n","    W_cycles = np.array(W_cycles)\n","\n","    W_mean = float(np.mean(W_cycles))\n","    P_mean = W_mean * f\n","\n","    return {\n","        \"t\": t, \"x\": x, \"v\": v, \"k\": k, \"F\": F, \"a_ext\": a_ext,\n","        \"W_cycles\": W_cycles, \"W_mean\": W_mean, \"P_mean\": P_mean,\n","        \"params\": dict(m=m,c=c,k_soft=k_soft,k_stiff=k_stiff,A=A,f=f,\n","                       n_cycles=n_cycles,steps_per_cycle=steps_per_cycle)\n","    }\n","\n","if __name__ == \"__main__\":\n","    res = simulate_alpo()\n","\n","    print(\"Parameters:\", res[\"params\"])\n","    print(f\"Steady-state mean work per cycle W_mean = {res['W_mean']:.6e} J\")\n","    print(f\"Steady-state mean power P_mean = {res['P_mean']:.6e} W\")\n","\n","    # Plot force–displacement loop for the last few cycles\n","    steps = res[\"params\"][\"steps_per_cycle\"]\n","    n_cycles = res[\"params\"][\"n_cycles\"]\n","    n_show = 3\n","    i0 = (n_cycles - n_show) * steps\n","    i1 = n_cycles * steps\n","\n","    plt.figure()\n","    plt.plot(res[\"x\"][i0:i1], res[\"F\"][i0:i1])\n","    plt.xlabel(\"x (m)\")\n","    plt.ylabel(\"F_spring (N)\")\n","    plt.title(\"Force–Displacement Loop (last cycles)\")\n","    plt.grid(True)\n","    plt.show()\n","\n","    # Plot work per cycle in the steady-state region\n","    plt.figure()\n","    plt.plot(res[\"W_cycles\"])\n","    plt.xlabel(\"Cycle index (steady-state)\")\n","    plt.ylabel(\"Work per cycle (J)\")\n","    plt.title(\"Work per cycle in steady state\")\n","    plt.grid(True)\n","    plt.show()"]}]}