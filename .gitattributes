# Normalize line endings so diffs stay clean across machines.
* text=auto eol=lf

*.sh   text eol=lf
*.bat  text eol=crlf

# Binary — never diff or merge these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.parquet binary
*.onnx binary
*.pt   binary

# Notebooks: treat as text but don't let GitHub count them as the repo language.
*.ipynb text linguist-detectable=false

# Keep generated/vendored files out of language stats and diffs.
**/vendor/**   linguist-vendored
**/generated/** linguist-generated
*.lock         linguist-generated -diff

# Byte-pinned evidence: never normalize. These trees are verified against
# recorded digests -- theory/SHA256SUMS, the notes register's per-import
# digest, each run's SHA256SUMS -- so an eol=lf rewrite on checkout changes
# the bytes the digest was taken over and the verification fails in a fresh
# clone while passing in the working tree it was written in. This repository
# caught exactly that on a CRLF import.
theory/**             -text
notes/imported/**     -text
runs/**               -text
corpus-import/**      -text
# paper/ is pinned by paper/SHA256SUMS the same way, and was missing here only
# because every edition before the 2026-08-30 rev. 5 upload was LF already.
# That upload carries CRLF; normalizing it on checkout would fail its pin in
# every fresh clone while passing in the tree it was pinned in.
paper/**              -text
